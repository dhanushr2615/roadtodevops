@Library('my-shared-lib') _

pipeline {
	agent any
	
	stages {
	    stage('Checkout') {
		steps {
			git branch: 'main' , url: 'https://github.com/dhanushr2615/roadtodevops.git'
			}
		}
	     
            stage('Install') {
		steps {
		       sh 'mvn clean install'
			}
		}

	    stage('Test') {
		steps {
			runTests()
			}
		}

	    stage('Versioning') {
		steps {
		       sh 'mvn --version'
			}
		}

	    stage('Archiving') {
                steps {
			archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
			junit '**/target/surefire-reports/*.xml'
			}
		}
	    stage('Deploy to Staging')
		steps {
		      deployToeEnv('staging')
			}
		}
	    stage('Deploy to Production') {
		steps {
		      deployToEnv('production')
			}
		}
	}
}
