library identifier: 'my-shared-library@main', retriever: modernSCM(
   [$class: 'GitSCMSource',
    remote: 'https://github.com/dhanushr2615/roadtodevops.git',
    credentialsId: 'github-token_PAT']
)
_

pipeline {
	agent any

	stages{
	    stage('verify library Content') {
                steps {
                    script {
                          echo "Checking if smartBuild exists in the DSL...."
			  def hasMethod = this.respondsTo('smartBuild')
		          echo "does smartBuild exist ? ${hasMethod}"
			}
		}
	}
		stage('Execute Shared Library') {
		  steps {
			script {
				smartBuild(imageName: 'pizza-mini-project')
				}
			}
		}
	}
}

