pipeline {
	agent any
	stages {
	    stage('Checkout') {
		steps {
			git branch: 'main' , url: 'https://github.com/dhanushr2615/roadtodevops.git'
			}
		}
	     
            stage('Terraform apply') {
		steps {
		       sh '''
			cd terraform
			terraform init
			terraform apply -auto-approve
			'''
			}
		}

	    stage('Verify Deployment') {
		steps {
			sh '''
			kubectl get pods -n demo
			kubectl get svc -n demo
			'''
			}
		}
	}
}
